#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$ROOT"
EXPECTED=$(cat .bun-version)
RUNTIME=$(command -v bun || true)
# Prefer a project-local pinned runtime when the PATH one is missing or a different version.
LOCAL_RUNTIME="$ROOT/tools/runtime/node_modules/.bin/bun"
if [ -x "$LOCAL_RUNTIME" ] && [ "$("$LOCAL_RUNTIME" --version 2>/dev/null || true)" = "$EXPECTED" ]; then
  if [ -z "$RUNTIME" ] || [ "$("$RUNTIME" --version 2>/dev/null || true)" != "$EXPECTED" ]; then RUNTIME="$LOCAL_RUNTIME"; fi
fi
COMMAND=${1:-start}
if [ "$#" -gt 0 ]; then shift; fi
if [ "$COMMAND" = bootstrap ]; then
  if [ "$#" -ne 0 ]; then echo 'bootstrap takes no arguments' >&2; exit 2; fi
fi
if [ -z "$RUNTIME" ] || [ ! -x "$RUNTIME" ]; then
  echo "Bun unavailable. Install Bun $EXPECTED and retry." >&2
  exit 1
fi
if [ "$("$RUNTIME" --version)" != "$EXPECTED" ]; then
  echo "Bun version mismatch: require $EXPECTED. Run ./scripts/cockpit bootstrap." >&2
  exit 1
fi
PATH="$(dirname -- "$RUNTIME"):$PATH"
export PATH
BUN_INSTALL_CACHE_DIR="$ROOT/.cache/bun"
export BUN_INSTALL_CACHE_DIR
BUN_TMPDIR="$ROOT/.cache/tmp"
export BUN_TMPDIR
mkdir -p "$BUN_TMPDIR"
case "$COMMAND" in
  bootstrap) exec "$RUNTIME" --no-env-file install --frozen-lockfile --ignore-scripts ;;
  start) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file src/index.ts ;;
  verify) [ "$#" -eq 0 ] || exit 2; "$RUNTIME" --no-env-file run typecheck; exec "$RUNTIME" --no-env-file test ;;
  host-check) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/host-check.ts ;;
  discovery-report) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/discovery-report.ts ;;
  m0b1a-smoke) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/m0b1a-smoke.ts ;;
  protocol-diagnose) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/protocol-diagnose.ts ;;
  e0-recovery-test) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/e0-recovery.ts ;;
  e2-claude-spike) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/e2-claude-spike.ts ;;
  e3-homologation) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/e3-homologation.ts ;;
  e4-homologation)
    # Typecheck, full deterministic suite, then the recovery drill (mock agents only; no msb, no VM, no running Cockpit touched).
    [ "$#" -eq 0 ] || exit 2
    "$RUNTIME" --no-env-file run typecheck
    "$RUNTIME" --no-env-file test
    exec "$RUNTIME" --no-env-file scripts/e4-homologation.ts ;;
  frontend-test) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file test tests/frontend.test.ts ;;
  artifact) exec "$RUNTIME" --no-env-file scripts/artifact.ts "$@" ;;
  service) exec "$RUNTIME" --no-env-file scripts/service.ts "$@" ;;
  f1-systemd-smoke) [ "$#" -eq 0 ] || exit 2; exec "$RUNTIME" --no-env-file scripts/f1-systemd-smoke.ts ;;
  *) echo 'Usage: ./scripts/cockpit [bootstrap|start|verify|host-check|discovery-report|m0b1a-smoke|protocol-diagnose|e0-recovery-test|e2-claude-spike|e3-homologation|e4-homologation|frontend-test|artifact|service|f1-systemd-smoke]' >&2; exit 2 ;;
esac
